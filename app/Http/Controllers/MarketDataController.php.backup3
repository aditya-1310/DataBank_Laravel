<?php

namespace App\Http\Controllers;

use App\Models\MarketData;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\URL;
use Illuminate\Support\Facades\Validator;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Facades\Log;
use Illuminate\Pagination\LengthAwarePaginator;
use League\Csv\Reader;
use Maatwebsite\Excel\Excel;
use Maatwebsite\Excel\Facades\Excel as ExcelFacade;

class MarketDataController extends Controller
{
    /**
     * Display a listing of market data.
     */
    public function index(Request $request)
    {
        try {
            Log::info('MarketDataController@index called', [
                'user_id' => Auth::id(),
                'symbol' => $request->symbol
            ]);
            // Data storage directory
            $storageDir = storage_path('app/market_data');
            if (!file_exists($storageDir)) {
                mkdir($storageDir, 0755, true);
            }
            
            // Get available symbols from index file
            $symbols = [];
            $indexFile = $storageDir . '/index.json';
            if (file_exists($indexFile)) {
                $index = json_decode(file_get_contents($indexFile), true);
                $symbols = $index['symbols'] ?? [];
            }
            
            // Filter by symbol if provided
            $requestSymbol = $request->has('symbol') ? strtoupper($request->symbol) : null;
            if ($requestSymbol) {
                $symbols = array_filter($symbols, function($symbol) use ($requestSymbol) {
                    return stripos($symbol, $requestSymbol) !== false;
                });
            }
            
            // Read market data from CSV files
            $allData = [];
            foreach ($symbols as $symbol) {
                $fileName = $storageDir . '/' . $symbol . '.csv';
                if (file_exists($fileName)) {
                    if (($handle = fopen($fileName, 'r')) !== false) {
                        // Get headers
                        $headers = fgetcsv($handle, 1000, ',');
                        
                        // Process data rows
                        while (($data = fgetcsv($handle, 1000, ',')) !== false) {
                            // Skip empty rows
                            if (count(array_filter($data)) === 0) {
                                continue;
                            }
                            
                            $row = [];
                            foreach ($headers as $index => $key) {
                                if (isset($data[$index])) {
                                    $row[$key] = $data[$index];
                                }
                            }
                            
                            // Add unique ID based on symbol and date
                            $row['id'] = $row['id'] ?? $symbol . '-' . str_replace('-', '', $row['date']);
                            
                            // Apply date filter if provided
                            if ($request->has('date') && $row['date'] != $request->date) {
                                continue;
                            }
                            
                            // Apply date range filter if provided
                            if ($request->has('date_from') && $request->has('date_to')) {
                                $date = \DateTime::createFromFormat('Y-m-d', $row['date']);
                                $fromDate = \DateTime::createFromFormat('Y-m-d', $request->date_from);
                                $toDate = \DateTime::createFromFormat('Y-m-d', $request->date_to);
                                
                                if (!$date || !$fromDate || !$toDate || $date < $fromDate || $date > $toDate) {
                                    continue;
                                }
                            }
                            
                            // For regular users, only show approved data unless it's their own
                            if (!Auth::user()->is_admin) {
                                $isApproved = ($row['is_approved'] ?? '0') == '1';
                                $isOwnData = ($row['user_id'] ?? '') == Auth::id();
                                
                                if (!$isApproved && !$isOwnData) {
                                    continue;
                                }
                            }
                            
                            $allData[] = $row;
                        }
                        
                        fclose($handle);
                    }
                }
            }
            
            // If no data and storage directory is empty, show empty state
            if (empty($allData) && count(glob($storageDir . '/*.csv')) === 0) {
                return view('market-data.index', [
                    'marketData' => [],
                    'paginator' => new \Illuminate\Pagination\LengthAwarePaginator(
                        [], 0, 10, 1, 
                        ['path' => \Illuminate\Support\Facades\Request::url(), 'query' => $request->query()]
                    )
                ]);
            }
            
            // Sort by date, most recent first
            usort($allData, function($a, $b) {
                $dateA = $a['date'] ?? '';
                $dateB = $b['date'] ?? '';
                return strcmp($dateB, $dateA);
            });
            
            // Paginate manually
            $page = (int)$request->input('page', 1);
            $perPage = 10;
            $total = count($allData);
            $offset = ($page - 1) * $perPage;
            $lastPage = max(1, ceil($total / $perPage));
            
            // Handle invalid page numbers
            if ($page < 1 || ($page > $lastPage && $total > 0)) {
                $page = 1;
                $offset = 0;
            }
            
            $marketData = array_slice($allData, $offset, $perPage);
            
            // Convert to objects to make it compatible with the view
            $marketData = array_map(function($item) {
                return (object) [
                    'id' => $item['id'] ?? '',
                    'date' => !empty($item['date']) ? \DateTime::createFromFormat('Y-m-d', $item['date']) : now(),
                    'symbol' => $item['symbol'] ?? '',
                    'open' => (float)($item['open'] ?? 0),
                    'high' => (float)($item['high'] ?? 0),
                    'low' => (float)($item['low'] ?? 0),
                    'close' => (float)($item['close'] ?? 0),
                    'volume' => (int)($item['volume'] ?? 0),
                    'is_approved' => ($item['is_approved'] ?? '0') == '1',
                    'user_id' => $item['user_id'] ?? Auth::id(),
                ];
            }, $marketData);
            
            // Create a custom paginator
            $paginator = new \Illuminate\Pagination\LengthAwarePaginator(
                $marketData,
                $total,
                $perPage,
                $page,
                ['path' => \Illuminate\Support\Facades\Request::url(), 'query' => $request->query()]
            );
            
            return view('market-data.index', compact('marketData', 'paginator'));
        } catch (\Exception $e) {
            Log::error('Error in MarketDataController@index', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);
            return response()->json([
                'error' => 'Failed to load market data',
                'message' => 'An error occurred while processing your request'
            ], 500);
        }
    }

    /**
     * Show the form for creating a new market data entry.
     */
    public function create()
    {
        return view('market-data.create');
    }

    /**
     * Store a newly created market data in storage.
     */
    public function store(Request $request)
    {
        $validated = $request->validate([
            'title' => 'required|string|max:255',
            'date' => 'required|date',
            'symbol' => 'required|string|max:10',
            'open' => 'required|numeric|min:0',
            'high' => 'required|numeric|min:0',
            'low' => 'required|numeric|min:0',
            'close' => 'required|numeric|min:0',
            'volume' => 'required|integer|min:0',
            'product_name' => 'required|string|max:255',
            'price' => 'required|numeric|min:0',
            'location' => 'required|string|max:255',
            'category' => 'required|string|max:255',
            'description' => 'nullable|string',
            'additional_info' => 'nullable|json',
        ]);
        
        $marketData = new MarketData($validated);
        $marketData->user_id = Auth::id();
        
        // If user is admin, auto-approve
        if (Auth::user()->is_admin) {
            $marketData->is_approved = true;
        }
        
        $marketData->save();
        
        return redirect()->route('market-data.index')
            ->with('success', 'Market data submitted successfully.');
    }

    /**
     * Display the specified market data.
     */
    public function show($id)
    {
        try {
            // Data storage directory
            $storageDir = storage_path('app/market_data');
            
            // Parse ID to get symbol and date
            $parts = explode('-', $id);
            $symbol = $parts[0];
            
            // Check if the symbol file exists
            $fileName = $storageDir . '/' . $symbol . '.csv';
            if (!file_exists($fileName)) {
                abort(404, 'Market data not found');
            }
            
            // Read the file
            $handle = fopen($fileName, 'r');
            $headers = fgetcsv($handle, 1000, ',');
            $marketData = null;
            
            // Process data rows
            while (($data = fgetcsv($handle, 1000, ',')) !== false) {
                // Skip empty rows
                if (count(array_filter($data)) === 0) {
                    continue;
                }
                
                $row = [];
                foreach ($headers as $index => $key) {
                    if (isset($data[$index])) {
                        $row[$key] = $data[$index];
                    }
                }
                
                // Generate ID
                $rowId = $symbol . '-' . str_replace('-', '', $row['date']);
                
                // If this is the row we want
                if ($rowId === $id || $row['id'] === $id) {
                    $marketData = (object) [
                        'id' => $rowId,
                        'date' => !empty($row['date']) ? \DateTime::createFromFormat('Y-m-d', $row['date']) : now(),
                        'symbol' => $row['symbol'] ?? $symbol,
                        'open' => (float)($row['open'] ?? 0),
                        'high' => (float)($row['high'] ?? 0),
                        'low' => (float)($row['low'] ?? 0),
                        'close' => (float)($row['close'] ?? 0),
                        'volume' => (int)($row['volume'] ?? 0),
                        'is_approved' => ($row['is_approved'] ?? '0') == '1',
                        'user_id' => $row['user_id'] ?? Auth::id(),
                    ];
                    break;
                }
            }
            
            fclose($handle);
            
            if (!$marketData) {
                abort(404, 'Market data not found');
            }
            
            // Check if the user can view this data
            if (!Auth::user()->is_admin && !$marketData->is_approved && $marketData->user_id !== Auth::id()) {
                abort(403, 'Unauthorized access');
            }
            
            return view('market-data.show', compact('marketData'));
        } catch (\Exception $e) {
            \Log::error('Error showing market data: ' . $e->getMessage());
            return redirect()->route('market-data.index')
                ->with('error', 'Error loading market data: ' . $e->getMessage());
        }
    }

